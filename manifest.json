{
  "manifest_version": 3,
  "name": "Veilmark",
  "version": "1.0.0",
  "description": "A private, user-defined text filter for the web.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "Veilmark",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "rules.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
